# API authentication
API_AUTH_ENABLED=true
API_TOKENS=replace-with-strong-token

# Service URLs (inside docker-compose network)
OCR_URL=http://ocr:8100
MOONDREAM_URL=https://api.moondream.ai/v1/query

# OCR runtime mode
OCR_DEVICE=cpu
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
FLAGS_use_mkldnn=0
FLAGS_enable_pir_api=0
FLAGS_enable_pir_in_executor=0

# Moondream API key
MOONDREAM_API_KEY=replace-with-moondream-api-key

# Request behavior
REQUEST_TIMEOUT_SECONDS=120
OCR_TEXT_SCORE_THRESHOLD=0.30

# Optional GPU selector for OCR container
OCR_GPU_DEVICE=0
